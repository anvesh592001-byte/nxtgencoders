NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional compatibility fallback for projects still using the legacy anon key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
# Optional: comma-separated verified domains. Leave blank to require admin approval.
NIAT_ALLOWED_EMAIL_DOMAINS=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server-only key for controlled maintenance scripts. Never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
